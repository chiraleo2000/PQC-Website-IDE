# Copy to infra/.env before: docker compose -f infra/docker-compose.yml up -d --build

# --- Required secrets (change in production) ---
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-minimum-32-character-jwt-secret
CRYPTO_SERVICE_SECRET=change-me-internal-crypto-shared-secret

# --- Database ---
POSTGRES_DB=pqc_ide
POSTGRES_USER=pqc_ide

# --- Sovereign / PQC policy ---
ENFORCE_PQC_ONLY=true
CRYPTO_USE_GO=true
PQC_DOMAIN=localhost

# --- Rate limits & sync ---
RATE_LIMIT_MAX=100
SYNC_RATE_LIMIT_MAX=30
MAX_PAYLOAD_BYTES=2097152
NONCE_TTL_MS=300000

# --- Optional ---
DEMO_CORS_ORIGINS=https://localhost
GIT_OPS_ENABLED=false
