# Copy to infra/.env before: docker compose -f infra/docker-compose.yml up -d --build

# --- Required secrets (change in production) ---
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-minimum-32-character-jwt-secret
CRYPTO_SERVICE_SECRET=change-me-internal-crypto-shared-secret

# --- Database ---
POSTGRES_DB=pqc_ide
POSTGRES_USER=pqc_ide

# --- Sovereign / PQC policy ---
ENFORCE_PQC_ONLY=true
CRYPTO_USE_GO=true
PQC_DOMAIN=localhost

# --- Rate limits & sync ---
RATE_LIMIT_MAX=100
SYNC_RATE_LIMIT_MAX=30
MAX_PAYLOAD_BYTES=2097152
NONCE_TTL_MS=300000

# --- Auth ---
# production Docker defaults: ALLOW_DEV_REGISTER=false, VITE_AUTH_MODE=login
ALLOW_DEV_REGISTER=false
VITE_AUTH_MODE=login
VITE_OIDC_ENABLED=false
# OIDC hooks (optional — endpoints return 501 until fully configured)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- Optional ---
DEMO_CORS_ORIGINS=https://localhost
GIT_OPS_ENABLED=false

# --- Cloudflare HTTPS ---
# API token needs Account / Cloudflare Pages / Edit. Never put this in the browser.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Tunnel token from Zero Trust > Networks > Tunnels. Origin service: http://web:8080
CLOUDFLARE_TUNNEL_TOKEN=
