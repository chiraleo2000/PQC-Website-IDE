# API Gateway (sovereign /api/* + demo /demo-api/*) — port 4000
PORT=4000
DEMO_CORS_ORIGINS=http://localhost:4010,http://127.0.0.1:4010
JWT_SECRET=change-me-in-production-min-32-chars
CRYPTO_SERVICE_URL=http://localhost:4081
CRYPTO_SERVICE_SECRET=internal-crypto-shared-secret
CRYPTO_USE_GO=false
ENFORCE_PQC_ONLY=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
MAX_PAYLOAD_BYTES=2097152
NONCE_TTL_MS=300000

# Database
DATABASE_URL=postgresql://pqc_ide:pqc_ide_secret@localhost:5432/pqc_ide

# Web IDE (Vite) — port 4001
WEB_PORT=4001
VITE_API_URL=http://localhost:4000

# Crypto service (Go) — port 4081
CRYPTO_PORT=4081
CRYPTO_MAX_BODY_BYTES=2097152
